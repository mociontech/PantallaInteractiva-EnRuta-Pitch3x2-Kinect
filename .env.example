# ── Servidor local (npm run server) ──────────────────────────────────────────
PORT=3001
# PIN de la pantalla del operador (/admin). Cámbialo.
ADMIN_PIN=1234
# Identificador de esta pared en los datos enviados a Evius
DEVICE_ID=pared-01
# Segundos que se espera a que la persona asignada empiece en la pared antes de pasar a la siguiente
TURN_TIMEOUT_MS=120000
# [CONFIRMAR] allow = una cédula puede jugar varias veces · block = solo una vez
REPLAY_POLICY=allow

# ── Base de asistentes (Sheet del cliente) ──────────────────────────────────
# Opción A: archivo CSV exportado del Sheet (server/data/asistentes.csv). Sin archivo se usa el de ejemplo.
ATTENDEES_CSV=server/data/asistentes.csv
# Opción B: URL de exportación CSV del Google Sheet (compartido por enlace). Tiene prioridad sobre el archivo.
# Formato: https://docs.google.com/spreadsheets/d/<ID>/export?format=csv&gid=<GID>
ATTENDEES_CSV_URL=
ATTENDEES_REFRESH_MS=300000
# Cómo viene el nombre en la base: auto (decide fila por fila; por defecto) · apellidos-nombres · nombres-apellidos · tal-cual
NAME_ORDER=auto

# ── Evius ([CONFIRMAR] con la documentación de su API) ──────────────────────
# http: envía a EVIUS_URL · mock: solo registra en consola · off: deja los envíos pendientes
EVIUS_MODE=
EVIUS_URL=
EVIUS_TOKEN=
EVIUS_AUTH_HEADER=Authorization
EVIUS_EXPERIENCE=pared-interactiva
EVIUS_RETRY_MS=15000

# ── Web (Vite) ──────────────────────────────────────────────────────────────
# Dirección del servidor si la web no se sirve desde él (vacío = mismo origen)
VITE_SERVER_URL=
# TouchDesigner (solo si se usa ?input=td)
VITE_TD_WS_URL=ws://localhost:9980
