# ── Servidor local (npm run server) ──────────────────────────────────────────
PORT=3001
# PIN de la pantalla del operador (/admin). Cámbialo.
ADMIN_PIN=1234
# Identificador de esta pared en los datos enviados a Evius
DEVICE_ID=pared-01
# Segundos que se espera a que la persona asignada empiece en la pared antes de pasar a la siguiente
TURN_TIMEOUT_MS=120000
# [CONFIRMAR] allow = una cédula puede jugar varias veces · block = solo una vez
REPLAY_POLICY=allow

# ── Base de asistentes (CSV del cliente: Identificación, Nombre de Empleado, Cargo de Trabajo) ──
# Ruta al CSV. Se carga al arrancar y también desde /admin ("Cargar CSV"). Sin archivo se usa el de ejemplo.
ATTENDEES_CSV_PATH=server/data/asistentes.csv
# Cómo viene el nombre: auto (decide fila por fila; por defecto) · apellidos-nombres · nombres-apellidos · tal-cual
NAME_ORDER=auto
# true: quien no está en el CSV puede registrarse en la tablet (cédula y nombre, sin cargo)
# false: se rechaza (solo entran los del CSV)  [CONFIRMAR]
ALLOW_UNLISTED=true

# ── Evius (Datahub) ──────────────────────────────────────────────────────────
# Sin EVIUS_URL no se envía nada: los puntajes se acumulan en el outbox y salen solos cuando se configure.
EVIUS_URL=
EVIUS_TOKEN=
EVIUS_EVENT_ID=
EVIUS_EXPERIENCE_ID=
# Nombre de esta experiencia tal como debe verse en Evius
EXPERIENCE_NAME=Pared interactiva EnRuta
# Outbox en disco (JSONL): se escribe ANTES de enviar y es también el respaldo/historial de lo jugado. No lo borres.
OUTBOX_PATH=server/data/outbox.jsonl
# Solo para pruebas locales: mock = no envía, solo registra en consola (y marca como entregado: no usar en el evento)
EVIUS_MODE=

# ── Web (Vite) ──────────────────────────────────────────────────────────────
# Dirección del servidor si la web no se sirve desde él (vacío = mismo origen)
VITE_SERVER_URL=
# TouchDesigner (solo si se usa ?input=td)
VITE_TD_WS_URL=ws://localhost:9980
